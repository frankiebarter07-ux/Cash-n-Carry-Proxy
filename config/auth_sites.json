{
  "_comment": "Login-gated sellers scraped by scripts/scrape_auth.py using Playwright. Credentials come ONLY from environment variables (GitHub Actions Secrets) named in cred_env -- never store passwords here. Selectors are candidate lists tried in order (first match wins), so login-form/price markup changes don't need code edits. VERIFY the selectors and product URLs against the live logged-in site once; where unknown they're marked and the site is disabled until filled.",
  "sites": {
    "Costco UK": {
      "enabled": false,
      "_note": "Disabled: Costco bulk oils are behind a business membership login the user does not have. Re-enable only if you get a business account + set COSTCO_ Secrets.",
      "cred_env": { "user": "COSTCO_USER", "pass": "COSTCO_PASS" },
      "login_url": "https://www.costco.co.uk/login",
      "username_selectors": [
        "#logonId", "input[name='logonId']", "input[name='j_username']",
        "input[type='email']", "input[autocomplete='username']"
      ],
      "password_selectors": [
        "#logonPassword", "input[name='logonPassword']", "input[name='j_password']",
        "input[type='password']", "input[autocomplete='current-password']"
      ],
      "submit_selectors": [
        "button[type='submit']", "#sign-in-button",
        "button:has-text('Sign In')", "button:has-text('Sign in')"
      ],
      "price_selectors": [
        "[itemprop='price']", ".product-price .notranslate", ".your-price .value",
        ".price-wrapper .notranslate", ".product-details-pricing__value", ".price"
      ],
      "products": [
        {
          "oil": "soybean", "product": "KTC Vegetable Oil 20L Box",
          "url": "https://www.costco.co.uk/Business-Delivery/Business-Delivery/KTC-Vegetable-Oil-20L-Box/p/76584_BD",
          "pack_value": 20, "pack_unit": "L"
        },
        {
          "oil": "soybean", "product": "KTC Super Hi-Fry Extra Long Life Vegetable Oil 20L",
          "url": "https://www.costco.co.uk/Business-Delivery/Business-Delivery/Oils-Salad-Dressing/KTC-Super-Hi-Fry-Extra-Long-Life-Vegetable-Oil-20L/p/507868_BD",
          "pack_value": 20, "pack_unit": "L"
        }
      ]
    },
    "Booker": {
      "enabled": true,
      "no_login": true,
      "_note": "Prices are public on Booker's category listing (no login). The scraper renders list_url with Playwright and matches product tiles by keyword. Verify tile parsing on the first CI run and adjust 'match'/'tile_selectors' if needed.",
      "list_url": "https://www.booker.co.uk/products/category?categoryName=Other_305250&itemHierarchy=Grocery_-_Catering|Cooking_Ingredients",
      "tile_selectors": [
        "[class*='product']", "[class*='tile']", "[class*='card']", "li"
      ],
      "products": [
        {
          "oil": "rapeseed", "product": "Chef's Larder Rapeseed Cooking Oil 20L",
          "match": ["chef's larder", "rapeseed", "20 lit"],
          "exclude": ["premium", "5 lit", "litho"],
          "pack_value": 20, "pack_unit": "L"
        },
        {
          "oil": "soybean", "product": "KTC Vegetable Cooking Oil 20L (Booker)",
          "match": ["ktc", "vegetable", "20 lit"],
          "exclude": ["rapeseed", "blend", "5 lit"],
          "pack_value": 20, "pack_unit": "L"
        }
      ]
    },
    "Magna Foodservice": {
      "enabled": true,
      "no_login": true,
      "_note": "Added from the seller list. WooCommerce-style store, prices appear public -> per-product URLs with JSON-LD expected. NO PRICE CAPTURED YET: the KTC Veg BIB URL below is confirmed; the drum and rapeseed URLs need filling from the live site (search 'KTC' in their oils category). Verify on first CI run.",
      "price_selectors": [
        "[itemprop='price']", ".woocommerce-Price-amount", "p.price .amount", ".summary .price"
      ],
      "products": [
        {
          "oil": "soybean", "product": "KTC Vegetable Oil (Bottle in Box) 20L (Magna)",
          "url": "https://www.magnafoodservice.co.uk/product/ktc-vegetable-oil-box-20ltr/",
          "pack_value": 20, "pack_unit": "L"
        },
        {
          "oil": "soybean", "product": "KTC Vegetable Cooking Oil Drum 20L (Magna)",
          "url": "FILL_FROM_MAGNA_SITE",
          "pack_value": 20, "pack_unit": "L"
        },
        {
          "oil": "rapeseed", "product": "KTC Extended Life Rapeseed Oil 20L (Magna)",
          "url": "FILL_FROM_MAGNA_SITE",
          "pack_value": 20, "pack_unit": "L"
        }
      ]
    },
    "Bestway Wholesale": {
      "enabled": false,
      "_note": "Disabled: Bestway prices need a trade login the user does not have. Re-enable with BESTWAY_ Secrets if you get an account.",
      "cred_env": { "user": "BESTWAY_USER", "pass": "BESTWAY_PASS" },
      "login_url": "https://www.bestwaywholesale.co.uk/login",
      "username_selectors": [
