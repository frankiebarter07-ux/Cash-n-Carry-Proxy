{
  "_comment": "Login-gated sellers scraped by scripts/scrape_auth.py using Playwright. Credentials come ONLY from environment variables (GitHub Actions Secrets) named in cred_env -- never store passwords here. Selectors are candidate lists tried in order (first match wins), so login-form/price markup changes don't need code edits. VERIFY the selectors and product URLs against the live logged-in site once; where unknown they're marked and the site is disabled until filled.",
  "sites": {
    "Costco UK": {
      "enabled": true,
      "cred_env": { "user": "COSTCO_USER", "pass": "COSTCO_PASS" },
      "login_url": "https://www.costco.co.uk/login",
      "username_selectors": [
        "#logonId", "input[name='logonId']", "input[name='j_username']",
        "input[type='email']", "input[autocomplete='username']"
      ],
      "password_selectors": [
        "#logonPassword", "input[name='logonPassword']", "input[name='j_password']",
        "input[type='password']", "input[autocomplete='current-password']"
      ],
      "submit_selectors": [
        "button[type='submit']", "#sign-in-button",
        "button:has-text('Sign In')", "button:has-text('Sign in')"
      ],
      "price_selectors": [
        "[itemprop='price']", ".product-price .notranslate", ".your-price .value",
        ".price-wrapper .notranslate", ".product-details-pricing__value", ".price"
      ],
      "products": [
        {
          "oil": "soybean", "product": "KTC Vegetable Oil 20L Box",
          "url": "https://www.costco.co.uk/Business-Delivery/Business-Delivery/KTC-Vegetable-Oil-20L-Box/p/76584_BD",
          "pack_value": 20, "pack_unit": "L"
        },
        {
          "oil": "soybean", "product": "KTC Super Hi-Fry Extra Long Life Vegetable Oil 20L",
          "url": "https://www.costco.co.uk/Business-Delivery/Business-Delivery/Oils-Salad-Dressing/KTC-Super-Hi-Fry-Extra-Long-Life-Vegetable-Oil-20L/p/507868_BD",
          "pack_value": 20, "pack_unit": "L"
        }
      ]
    },
    "Booker": {
      "enabled": false,
      "_todo": "Log in to booker.co.uk, open each product, copy its URL into 'url' below and its price-element selector into price_selectors, then set enabled=true. Booker requires login even to view product pages, so these URLs can't be discovered anonymously.",
      "cred_env": { "user": "BOOKER_USER", "pass": "BOOKER_PASS" },
      "login_url": "https://www.booker.co.uk/login",
      "username_selectors": [
        "#username", "input[name='username']", "input[name='j_username']",
        "input[type='email']", "input[autocomplete='username']"
      ],
      "password_selectors": [
        "#password", "input[name='password']", "input[name='j_password']",
        "input[type='password']", "input[autocomplete='current-password']"
      ],
      "submit_selectors": [
        "button[type='submit']", "button:has-text('Sign in')", "button:has-text('Log in')"
      ],
      "price_selectors": [
        "[itemprop='price']", ".product-price", ".price", "[data-testid='price']"
      ],
      "products": [
        {
          "oil": "rapeseed", "product": "Chef's Larder Rapeseed Cooking Oil 20L",
          "url": "FILL_ME_FROM_LOGGED_IN_BOOKER",
          "pack_value": 20, "pack_unit": "L"
        },
        {
          "oil": "soybean", "product": "Chef's Larder Vegetable Cooking Oil 20L",
          "url": "FILL_ME_FROM_LOGGED_IN_BOOKER",
          "pack_value": 20, "pack_unit": "L"
        }
      ]
    },
    "Bestway Wholesale": {
      "enabled": true,
      "_note": "Product URLs are public (price is login-gated), so this is ready once BESTWAY_USER/PASS Secrets are set. Verify the login/price selectors on first run.",
      "cred_env": { "user": "BESTWAY_USER", "pass": "BESTWAY_PASS" },
      "login_url": "https://www.bestwaywholesale.co.uk/login",
      "username_selectors": [
        "#email", "input[name='email']", "input[name='username']",
        "input[type='email']", "input[autocomplete='username']"
      ],
      "password_selectors": [
        "#password", "input[name='password']", "input[type='password']",
        "input[autocomplete='current-password']"
      ],
      "submit_selectors": [
        "button[type='submit']", "button:has-text('Sign in')", "button:has-text('Login')"
      ],
      "price_selectors": [
        "[itemprop='price']", ".price", ".product-price", ".pdp-price"
      ],
      "products": [
        {
          "oil": "rapeseed", "product": "Consumer's Pride Rapeseed Cooking Oil 20L",
          "url": "https://www.bestwaywholesale.co.uk/product/388027-1",
          "pack_value": 20, "pack_unit": "L"
        },
        {
          "oil": "rapeseed", "product": "White Pearl Rapeseed Oil 20L",
          "url": "https://www.bestwaywholesale.co.uk/product/778644-1",
          "pack_value": 20, "pack_unit": "L"
        }
      ]
    },
    "Bidfood": {
      "enabled": false,
      "_todo": "Log in to bidfood.co.uk, open each product, paste its URL into 'url' below and set enabled=true. Bidfood needs a login to view product pages.",
      "cred_env": { "user": "BIDFOOD_USER", "pass": "BIDFOOD_PASS" },
      "login_url": "https://www.bidfood.co.uk/login/",
      "username_selectors": [
        "#username", "input[name='username']", "input[type='email']",
        "input[autocomplete='username']"
      ],
      "password_selectors": [
        "#password", "input[name='password']", "input[type='password']",
        "input[autocomplete='current-password']"
      ],
      "submit_selectors": [
        "button[type='submit']", "button:has-text('Sign in')", "button:has-text('Log in')"
      ],
      "price_selectors": [
        "[itemprop='price']", ".price", ".product-price", "[data-testid='price']"
      ],
      "products": [
        {
          "oil": "rapeseed", "product": "Rapeseed Oil 20L (Bidfood)",
          "url": "FILL_ME_FROM_LOGGED_IN_BIDFOOD",
          "pack_value": 20, "pack_unit": "L"
        },
        {
          "oil": "soybean", "product": "Vegetable (soya) Oil 20L (Bidfood)",
          "url": "FILL_ME_FROM_LOGGED_IN_BIDFOOD",
          "pack_value": 20, "pack_unit": "L"
        }
      ]
    }
  }
}
