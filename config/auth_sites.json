          "oil": "rapeseed", "product": "Consumer's Pride Rapeseed Cooking Oil 20L",
          "url": "https://www.bestwaywholesale.co.uk/product/388027-1",
          "pack_value": 20, "pack_unit": "L"
        },
        {
